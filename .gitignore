# ESP-IDF build output. sdkconfig is regenerated from sdkconfig.defaults, which
# is where every deliberate setting for this project lives.
build/
firmware/esp32/build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
# Raw dataset (huge, not original work — regenerate/re-download separately)
ml/data/dccrn_dataset/
ml/data/dccrn_dataset.zip
*.zip

# Trained model weights (large binaries — share via Drive/HF instead of git)
ml/checkpoints/
ml/models/checkpoints/
*.pt
*.pth

# Training logs / TensorBoard event files
ml/logs/
*.tfevents.*

# Generated evaluation outputs (regenerate anytime via evaluate.py)
ml/results/
ml/reports/*.json
ml/reports/*.csv

# Host tools
__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/
.mypy_cache/
.coverage
*.pyo
*.egg-info/

# Captures and the dashboards generated from them
recordings/
*.wav
*.html
backups/
# Jetson-specific deployment (not used this round — Raspberry Pi only)
upload_to_hf.py
jetson_download_and_run.py

# OS / editor junk
.DS_Store
Thumbs.db
# Keep project editor settings that are intentionally committed.
!.vscode/
!.vscode/settings.json
*.swp
